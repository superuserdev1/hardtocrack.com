{
  "name": "htc-orders",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "htc-orders",
      "database_id": "49a49304-9bc1-4421-bd9b-ce3b04ce1f77"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "HTC_EMAIL": "pedidos@hardtocrack.com",
    "MAIL_FROM": "pedidos@avisos.hardtocrack.com",
    "ORDERS_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRznBh2y2Lwr8Fo"
  },
  "previews": {
    "vars": {
      "HTC_EMAIL": "pedidos@hardtocrack.com",
      "MAIL_FROM": "pedidos@avisos.hardtocrack.com",
      "ORDERS_ENABLED": "true",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFRznBh2y2Lwr8Fo"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "htc-orders-preview",
        "database_id": "13bc5d16-3db3-42cf-bfdc-47854f6aa196"
      }
    ]
  }
}
