{
  "name": "htc-orders",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
